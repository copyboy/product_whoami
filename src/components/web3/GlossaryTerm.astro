---
export interface Props {
  term: string;
  class?: string;
}

const { term, class: className } = Astro.props;

// All glossary definitions
const definitions: Record<string, string> = {
  Layer1: "Layer1 是区块链网络的基础层，直接对标 Bitcoin、Ethereum、Solana 等。它们负责共识、区块生产和数据存储，所有 Layer2 都依赖于 Layer1 提供最终安全性。",
  Layer2: "Layer2 是构建在 Layer1 之上的扩展层，通过 Rollup 技术提升吞吐量、降低费用。Optimistic Rollups（如 Arbitrum）和 ZK Rollups（如 zkSync）是两大主流方案。",
  DeFi: "DeFi（去中心化金融）是通过智能合约实现的金融协议，无需中间商。核心应用包括借贷（Aave）、交易所（Uniswap）、稳定币（MakerDAO）等。",
  NFT: "NFT（非同质化代币）是基于 ERC-721 标准的独特数字资产，可代表艺术品、游戏道具、域名等。与同质化代币（每枚相同）不同，NFT 每枚唯一。",
  NFTFi: "NFT-Fi 是解决 NFT 流动性问题的协议集合，包括 NFT 抵押借贷、碎片化、衍生品等，让 NFT 持有者不必抛售就能获得流动性。",
  DAO: "DAO（去中心化自治组织）是基于智能合约和代币治理的组织形式，成员通过提案和投票共同决策，没有中心化管理层。",
  TVL: "TVL（Total Value Locked）是存入 DeFi 或 L2 协议的资产总值，是衡量协议规模的直接指标，但不代表协议盈利能力。",
  TPS: "TPS（Transactions Per Second）是每秒处理交易数。Bitcoin ~7 TPS，Ethereum ~15-30 TPS，Solana 实际约 1,000-4,000 TPS（理论上限 65,000）。",
  EVM: "EVM（Ethereum Virtual Machine）是以太坊的图灵完备虚拟机，所有以太坊智能合约都运行在 EVM 上。EVM 兼容性是以太坊生态最大的护城河。",
  "字节码": "字节码（bytecode）是智能合约编译后的 EVM 指令序列，部署时上链、存储在合约账户里，由 EVM 逐条执行，人不可直接读。",
  "操作码": "操作码（opcode）是 EVM 的最小指令集单元，以栈式方式执行。与字节码的关系：字节码 = 操作码序列。",
  Gas: "Gas 是以太坊网络的计算费用单位。用户发起交易或执行智能合约时需要支付 Gas，费用 = Gas 消耗量 × Gas 单价（gwei）。",
  gwei: "gwei 是以太坊 Gas 单价的最小常用单位，1 gwei = 10^-9 ETH（1 ETH = 10 亿 gwei）。它是费用换算的桥梁：费用（ETH）= Gas 消耗量 × 单价（gwei）× 10^-9。",
  PoW: "PoW（工作量证明）要求矿工通过计算难题竞争出块权，比特币目前使用此共识机制，能耗较高。",
  PoS: "PoS（权益证明）要求验证者质押代币参与共识，能耗比 PoW 低 99.95%。以太坊 2022 年通过 Merge 升级完成 PoW 到 PoS 的转变。",
  UTXO: "UTXO（Unspent Transaction Output，未花费交易输出）是比特币的记账模型：每笔交易消耗旧的 UTXO、创造新的 UTXO，类似现金找零，没有「账户余额」概念。",
  "账户模型": "账户模型（Account Model）是以太坊的记账方式：每个地址对应一条全局状态（余额 + nonce，合约账户还有代码与存储），转账是对状态数值的直接改写，而不是 UTXO 那样销毁旧输出、创造新输出。",
  "Nonce": "Nonce 是以太坊账户已发起交易的计数器，每确认一笔交易加一，是账户模型下防重放/防双花的核心机制；UTXO 模型靠「每个输出只能被花费一次」天然防双花，不需要 nonce。",
  "共识机制": "共识机制是分布式网络就「历史记录是什么」达成一致的规则。比特币用 PoW（算力竞争），以太坊用 PoS（权益质押）。",
  "全节点": "全节点下载并独立验证全部区块数据的比特币节点，不信任任何人。矿工生产历史，全节点审计历史。",
  "内存池": "内存池（mempool）是节点本地存放待确认交易的候车厅。每个节点独立维护，不是全网统一的，也不是共识的一部分。",
  "矿池": "矿池把大量矿工的算力聚合起来共同出块，按算力份额分配收益，把 Solo 挖矿的「百年彩票」变成稳定现金流。",
  AMM: "AMM（自动化做市商）通过数学公式（通常是 x*y=k 恒定乘积）而非订单簿为交易对定价。Uniswap 是最著名的 AMM 协议。",
  LP: "LP（Liquidity Provider，流动性提供者）是向 AMM 池存入两种资产的人，赚取交易手续费分成，同时承担无常损失的风险。",
  "无常损失": "无常损失（Impermanent Loss）是 LP 按公式比例持有两种资产，价格偏离存入时比例后，取出价值低于一直持有不动的 HODL 价值的差额；价格回到原点损失归零，「无常」由此得名。",
  "智能合约": "智能合约是部署在区块链上的程序代码，当满足预设条件时自动执行。无需中间商，可实现借贷、交易、保险等自动化逻辑。",
  Solidity: "Solidity 是以太坊智能合约的主流编程语言，语法近似 JavaScript，编译为 EVM 字节码后在链上执行。",
  Hardhat: "Hardhat 是以太坊主流的本地开发框架：内置本地测试网络，提供合约编译、自动化测试（Mocha/Chai + ethers）与部署脚本管理，是 Remix 在线 IDE 之后的进阶工作流。",
  "测试网": "测试网（Testnet）是模仿主网规则但代币无价值的目标网络，如以太坊 Sepolia，供开发者免费验证合约与应用。",
  "水龙头": "水龙头（faucet）是免费领取测试币的服务的通称，领取后即可在测试网支付 gas。",
  "DApp": "DApp（去中心化应用）是前端界面 + 链上智能合约作后端的应用形态：规则写进合约、状态存在链上，没有人能单方面下架或篡改它——这正是中心化平台「说封号就封号」痛点的解法。",
  "MetaMask": "MetaMask 是主流的浏览器加密钱包：管理账户与私钥、为交易签名，并向网页注入 window.ethereum 对象供 DApp 连接，是普通用户进入以太坊生态最常用的入口。",
  Rollup: "Rollup 将大量交易打包后在链下执行，仅将压缩后的数据或证明提交到主网，兼顾扩展性和安全性。",
  "Optimistic Rollups": "乐观 Rollup 假设所有交易有效，7 天挑战期内存款可被欺诈证明撤销。Arbitrum 和 Optimism 是主要实现。",
  "ZK Rollups": "ZK Rollups 通过零知识证明验证交易有效性，无需信任假设且无延迟等待期。zkSync 和 Starknet 是主要实现。",
  MPC: "MPC（安全多方计算）将私钥分片给多个参与者，任何单点都无法获取完整私钥。AI Agent 钱包常用 MPC 技术实现资产自主管理。",
  MEV: "MEV（矿工可提取价值）是指验证者/矿工通过操纵交易顺序获取的额外利润，包括闪电贷攻击、三明治攻击等。",
  EIP1559: "EIP-1559 是以太坊 2021 年的伦敦升级，引入基础费燃烧机制，使 ETH 成为通缩资产的可能性。",
  Blob: "Blob 是 Dencun 升级引入的数据存储方案，大幅降低 L2 数据发布费用，使 L2 手续费降低 10-100 倍。",
  "不可能三角": "不可能三角（区块链三难困境 Trilemma）指去中心化、安全性、可扩展性三者不可同时兼得——提高区块参数确实能提速，但全节点硬件门槛随之抬高、能独立验证的节点变少，等于用去中心化换吞吐；Layer2 的思路是不动 L1 参数、把执行搬走，绕开这道选择题。",
  "数据可用性": "数据可用性（Data Availability，DA）指任何人都能从 L1 取回 Rollup 的完整交易数据——执行可以搬下链，数据必须留链上，否则没人能独立验证 L2 的账本，安全锚就断了；blob 即以太坊为 DA 开辟的廉价数据空间。",
  "Account Abstraction": "账户抽象让钱包从「私钥控制」升级为「智能合约控制」，可实现社交恢复、多签、无 gas 赞助交易等。ERC-4337 定义了独立标准，EIP-7702 则允许 EOA 账户委托合约代码执行。",
  ERC20: "ERC-20 是以太坊的同质化代币标准，所有在以太坊上发行的代币（USDT、DAI、UNI 等）都遵循此标准。",
  ERC721: "ERC-721 是以太坊的 NFT 标准，定义了如何创建和转移独特的非同质化代币。",
  MiCA: "MiCA（加密资产市场监管）是欧盟 2024 年生效的加密资产监管框架，为数字资产发行和服务提供商提供统一监管规则。",
  "Uniswap V4": "Uniswap V4 引入 Hook 机制，允许开发者自定义交易池规则，实现限价单、时间加权做市（TWAMM）、动态费率等高级功能。",
  Aave: "Aave 是最大的去中心化借贷协议，存款人提供流动性获取收益，借款人以超额抵押方式借出资产。支持闪电贷。",
  MakerDAO: "MakerDAO 是去中心化稳定币 DAI 的发行协议，用户超额抵押 ETH 等资产生成 DAI，DSR 让 DAI 持有者获得存款收益。",
  Solana: "Solana 是高性能公链，采用 PoH（历史证明）+ PoS 共识，实际吞吐约 1,000-4,000 TPS（理论上限 65,000），费用低于 $0.001，但历史上曾有网络宕机记录。",
  Cosmos: "Cosmos 通过 IBC 协议连接 100+ 条区块链，是最大的跨链生态之一。Tendermint BFT 共识是其核心技术。",
  Bitcoin: "Bitcoin 是第一个区块链网络，主要作为数字黄金和价值存储，ETF 已获批并吸引大量机构资金。",
  Ethereum: "Ethereum 是世界计算机，智能合约平台，DeFi 和 NFT 生态的基础。ETH 是全球第二大加密货币。",
  "AI Agent": "AI Agent 是自主执行的 AI 程序，可在链上自主操作资产。Web3 为 AI Agent 提供支付通道、身份认证和资产自主管理能力。",
  DePIN: "DePIN（去中心化物理基础设施网络）通过代币激励共享物理资源（带宽、算力、存储），替代传统中心化数据中心。",
  RWA: "RWA（现实世界资产代币化）将房地产、国债等现实资产上链，获得 24/7 流动性和全球可访问性。贝莱德 BUIDL 是标志性产品。",
  "Prediction Markets": "Prediction Markets（预测市场）通过市场机制聚合信息，参与者交易事件结果概率。Polymarket 是最活跃的加密预测市场。",
  "Blur": "Blur 是 NFT 交易平台和借贷协议，以零平台费和高效批量挂单著称。",
  "Uniswap": "Uniswap 是以太坊上最大的 DEX（去中心化交易所），采用 AMM 机制。V4 版本引入 Hook 创新。",
  "Curve": "Curve 是专注稳定币和资产兑换的 AMM DEX，擅长低滑点大额稳定币交易。",
  "Convex": "Convex 是 Curve 生态的收益优化平台，帮助 Curve LP 获取额外收益并参与治理。",
  "gauge voting": "Gauge voting 是 Curve 生态的流动性激励分配机制，CRV 持有者投票决定哪些池获得 CRV 奖励。",
  "Health Factor": "Health Factor（健康因子）是 Aave 等借贷协议中的清算风险指标，HF < 1 时触发自动清算。",
  "稳定币": "稳定币（Stablecoin）是锚定法币价值（通常 1 美元）的加密货币，如 DAI、USDC。去中心化发行路线靠超额抵押与清算维持锚定；对照中心化托管路线（公司发币、储备金托管在银行）一句带过即可。",
  "算法稳定币": "算法稳定币（Algorithmic Stablecoin）不靠足额储备、靠协议的铸造/销毁与套利机制维持锚定的稳定币，「部分算法」则混合少量储备。需求信心一旦逆转，锚定本身成为抛压来源——UST 2022 年 5 月崩盘是这条路线最著名的失败案例，也把「锚定的信用从哪来」变成稳定币设计的必答题。",
  "脱锚": "脱锚（Depeg）是稳定币市场价格偏离锚定值（如 1 美元）的现象。轻微脱锚靠套利与赎回机制拉回，深度脱锚则是储备可信度或机制信用的崩塌——历史上多次脱锚事件幅度与持续时间差异极大，比较时用定性描述而非单点数字。",
  "aToken": "aToken 是 Aave 的生息存款凭证：存款入池后收到 aToken，余额随利息自动增长，赎回时 1:1 取回底层资产；Compound 的对应物是 cToken。",
  "超额抵押": "超额抵押（Overcollateralization）指抵押品价值高于借款金额，是链上借贷的前提——链上没有信用记录与追索权，只能靠「抵押品够多 + 随时可清算」约束违约动机。",
  "闪电贷": "闪电贷是 DeFi 的无抵押短期贷款，必须在同一区块内归还。用于套利、清算等紧急操作。",
  "清算": "清算是 DeFi 借贷协议中的风险控制机制，当抵押品价值下跌导致 Health Factor < 1，Keeper 机器人自动执行清算，清算人获得 5-10% 罚金。",
  "预言机": "预言机（Oracle）是把链下真实世界数据（价格、汇率、事件结果等）喂给智能合约的中间服务，如把资产价格喂给 DeFi 协议。智能合约自身无法主动获取链外数据，链下输入依赖预言机——这也引入了「喂价是否可信」的新信任假设。",
  "原子性": "原子性（Atomicity）指一笔交易内的所有操作要么全部生效、要么整体回滚到未发生状态，不存在执行一半的中间态。它是闪电贷「同区块借还、不还即回滚」的机制基础。",
  "三明治攻击": "三明治攻击（Sandwich Attack）是 MEV 的典型形态：攻击者在受害交易前后的同一区块内各插入一笔交易，像两片面包夹住目标交易，通过制造价格偏移赚取差价，受害者以更差价格成交。",
  "聚合器": "聚合器（Aggregator）是站在多个 DeFi 协议之上的路由层：DEX 聚合器把一笔交易拆分路由到多个流动性池找最优价，收益聚合器把策略打包自动复投，用户只需面对一个入口。",
  "收益金库": "收益金库（Vault）是 Yearn 开创的策略抽象——用户存入一种资产，合约自动执行「存入协议→收息→复投→调仓」循环，份额以凭证记账，策略复杂度对用户透明。",
  "APY": "APY（Annual Percentage Yield）是复利口径的年化收益率。DeFi 中高 APY 常来自代币激励而非现金流，APY 越高往往意味着风险与激励衰减越快，不等于真实长期回报。",
  "治理代币": "治理代币（Governance Token）是赋予持有者协议治理权的代币——可提交提案、投票决定协议参数与金库使用；其价值支撑来自治理权与协议的价值捕获设计，而非公司股权。",
  "Quadratic Voting": "Quadratic Voting（二次方投票）的票数按 √(代币数) 计，投票成本随影响力平方增长，巨鲸话语权边际递减，用于缓解 1 token = 1 票的富者越富；代价是机制复杂、需防拆分多账户绕过。",
  "时间锁": "时间锁（Timelock）是治理执行的延迟窗口——投票通过的提案不立即执行，须等待约 1-2 天窗口期，给社区留出发现恶意提案后的反应时间，是治理合约的标配安全层。",
  "Snapshot": "Snapshot 是最常用的链下投票工具：在指定区块高度对持币地址拍照记账，投票与计票在链下完成、结果回链执行，零 gas 成本；因快照先于投票，天然免疫闪电贷借币投票。",
  "代币经济学": "代币经济学（Tokenomics）是代币的供给、分配与价值捕获设计——总量曲线（固定上限/通胀/销毁）、各方分配与解锁节奏、协议收入如何回流持币者；它决定代币是可持续的协作协调工具还是击鼓传花的筹码。",
  "Vesting": "Vesting（归属/锁仓）是代币分期的解锁机制——团队与投资者份额通常按锁仓期加线性归属逐步解锁，防止早期持有人在上市初期集中抛售砸盘；解锁日程是供给端最大的短期变量。",
  "多签": "多签（Multi-sig）是 m-of-n 签名模型——n 把私钥共同持有钥匙，任意 m 把签名即可执行交易。单人失窃或离线不足以动金库，少数人合谋也不足以独断，是 DAO 金库与协议敏感操作的标准配置，典型如 Gnosis Safe 3/7。",
  "Gnosis Safe": "Gnosis Safe 是最广泛使用的多签钱包合约：以智能合约账户承载 m-of-n 签名权，支持插件化权限、时间锁延迟与链上交易提案-确认流程，是 DAO 金库管理的事实标准。",
  "重入攻击": "重入攻击（Reentrancy）是外部合约在余额扣减前被回调、递归重复提款的攻击模式——The DAO 2016 事件中被提走当时流通 ETH 的数个百分点量级，直接催生以太坊硬分叉；防御即 checks-effects-interactions 模式：先改状态、记账在后、外部交互放最后。",
  "硬分叉": "硬分叉（Hard Fork）是协议规则变更导致的不兼容分链——节点必须升级，否则留在旧链。The DAO 事件后的干预性分叉将以太坊唯一一次大规模回滚先例写进历史：分出的原链延续为 ETC，也留下「代码即规则」与「人治干预」的长期争论。",
};

const definition = definitions[term] || `${term} 是 Web3 领域的重要概念。`;
---

<span class:list={["glossary-term", className]} data-definition={definition}>{term}</span>

<style>
  .glossary-term {
    border-bottom: 1px dashed currentColor;
    cursor: help;
    position: relative;
  }

  .glossary-term::after {
    content: attr(data-definition);
    position: absolute;
