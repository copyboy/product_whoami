---
import ThreeColumnLayout from '@layouts/ThreeColumnLayout.astro';
import GlossaryTerm from '@components/web3/GlossaryTerm.astro';
---

<ThreeColumnLayout
  title="Web3 深度研究报告 | Gerrad's Digital Garden"
  description="Web3 横纵分析法深度调研 - 2026年4月版"
>
  <div class="min-h-screen">
    <!-- Terminal-style header -->
    <header class="mb-12">
      <div class="rounded-lg border border-slate-200 dark:border-[#30363d] bg-white dark:bg-[#161b22] overflow-hidden mb-6 transition-colors">
        <div class="flex items-center gap-2 px-4 py-3 bg-slate-100 dark:bg-[#0d1117] border-b border-slate-200 dark:border-[#30363d] transition-colors">
          <div class="w-3 h-3 rounded-full bg-red-400"></div>
          <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
          <div class="w-3 h-3 rounded-full bg-green-400"></div>
          <span class="ml-4 text-xs font-mono text-slate-500 dark:text-[#8b949e]">web3_research_v2.sh</span>
        </div>
        <div class="p-6">
          <div class="font-mono text-sm text-emerald-600 dark:text-[#7ee787] mb-2">$ cat web3_research_2026.md</div>
          <h1 class="text-3xl font-bold text-slate-900 dark:text-white mb-2">
            Web3 <span class="text-blue-600 dark:text-[#58a6ff]">深度研究报告</span>
          </h1>
          <p class="text-slate-500 dark:text-[#8b949e] text-sm font-mono mb-4">
            // 五阶段认知模型 | 理解去中心化的进化路径
          </p>
          <div class="flex items-center gap-4 text-xs text-slate-500 dark:text-[#8b949e]">
            <span class="font-mono">updated: <span class="text-emerald-600 dark:text-[#7ee787]">2026.09.07</span></span>
            <span class="font-mono">status: <span class="text-amber-600 dark:text-[#f0883e]">active</span></span>
            <span class="font-mono">version: <span class="text-blue-600 dark:text-[#58a6ff]">3.0</span></span>
          </div>
        </div>
      </div>

      <!-- 5-Phase Roadmap Overview -->
      <div class="grid grid-cols-1 md:grid-cols-5 gap-3 mb-6">
        <a href="/web3/phase/1" class="group p-4 rounded-lg border border-indigo-200 dark:border-indigo-500/30 bg-indigo-50 dark:bg-indigo-500/5 hover:bg-indigo-100 dark:hover:bg-indigo-500/10 transition-colors">
          <div class="flex items-center gap-2 mb-2">
            <div class="w-8 h-8 rounded-lg bg-indigo-500 text-white font-bold flex items-center justify-center text-sm">1</div>
            <span class="font-mono text-xs text-indigo-600 dark:text-indigo-400">Bitcoin</span>
          </div>
          <p class="text-sm font-medium text-slate-800 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400">去中心化价值转移</p>
        </a>
        <a href="/web3/phase/2" class="group p-4 rounded-lg border border-purple-200 dark:border-purple-500/30 bg-purple-50 dark:bg-purple-500/5 hover:bg-purple-100 dark:hover:bg-purple-500/10 transition-colors">
          <div class="flex items-center gap-2 mb-2">
            <div class="w-8 h-8 rounded-lg bg-purple-500 text-white font-bold flex items-center justify-center text-sm">2</div>
            <span class="font-mono text-xs text-purple-600 dark:text-purple-400">Ethereum</span>
          </div>
          <p class="text-sm font-medium text-slate-800 dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400">去中心化计算</p>
        </a>
        <a href="/web3/phase/3" class="group p-4 rounded-lg border border-emerald-200 dark:border-emerald-500/30 bg-emerald-50 dark:bg-emerald-500/5 hover:bg-emerald-100 dark:hover:bg-emerald-500/10 transition-colors">
          <div class="flex items-center gap-2 mb-2">
            <div class="w-8 h-8 rounded-lg bg-emerald-500 text-white font-bold flex items-center justify-center text-sm">3</div>
            <span class="font-mono text-xs text-emerald-600 dark:text-emerald-400">DApp</span>
          </div>
          <p class="text-sm font-medium text-slate-800 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400">去中心化应用</p>
        </a>
        <a href="/web3/phase/4" class="group p-4 rounded-lg border border-amber-200 dark:border-amber-500/30 bg-amber-50 dark:bg-amber-500/5 hover:bg-amber-100 dark:hover:bg-amber-500/10 transition-colors">
          <div class="flex items-center gap-2 mb-2">
            <div class="w-8 h-8 rounded-lg bg-amber-500 text-white font-bold flex items-center justify-center text-sm">4</div>
            <span class="font-mono text-xs text-amber-600 dark:text-amber-400">DeFi</span>
          </div>
          <p class="text-sm font-medium text-slate-800 dark:text-white group-hover:text-amber-600 dark:group-hover:text-amber-400">去中心化金融市场</p>
        </a>
        <a href="/web3/phase/5" class="group p-4 rounded-lg border border-pink-200 dark:border-pink-500/30 bg-pink-50 dark:bg-pink-500/5 hover:bg-pink-100 dark:hover:bg-pink-500/10 transition-colors">
          <div class="flex items-center gap-2 mb-2">
            <div class="w-8 h-8 rounded-lg bg-pink-500 text-white font-bold flex items-center justify-center text-sm">5</div>
            <span class="font-mono text-xs text-pink-600 dark:text-pink-400">DAO</span>
          </div>
          <p class="text-sm font-medium text-slate-800 dark:text-white group-hover:text-pink-600 dark:group-hover:text-pink-400">去中心化组织</p>
        </a>
      </div>

      <nav class="flex flex-wrap gap-4 text-sm font-mono">
        <a href="#phase1" class="text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300">→ 01_价值转移</a>
        <a href="#phase2" class="text-purple-600 dark:text-purple-400 hover:text-purple-700 dark:hover:text-purple-300">→ 02_计算</a>
        <a href="#phase3" class="text-emerald-600 dark:text-emerald-400 hover:text-emerald-700 dark:hover:text-emerald-300">→ 03_应用</a>
        <a href="#phase4" class="text-amber-600 dark:text-amber-400 hover:text-amber-700 dark:hover:text-amber-300">→ 04_金融市场</a>
        <a href="#phase5" class="text-pink-600 dark:text-pink-400 hover:text-pink-700 dark:hover:text-pink-300">→ 05_组织</a>
        <a href="#synthesis" class="text-cyan-600 dark:text-cyan-400 hover:text-cyan-700 dark:hover:text-cyan-300">→ 06_综合</a>
      </nav>
    </header>

    <!-- Section 01: 去中心化价值转移 (Bitcoin) -->
    <section id="phase1" class="mb-16 scroll-mt-8">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-500 to-purple-600 text-white font-bold flex items-center justify-center">1</div>
        <div>
          <h2 class="text-2xl font-bold text-slate-900 dark:text-white">去中心化价值转移</h2>
          <p class="text-slate-500 dark:text-[#8b949e] text-sm font-mono">Bitcoin · 核心问题：能不能用数学代替机构？</p>
        </div>
      </div>

      <div class="pl-4 border-l-2 border-indigo-500 dark:border-indigo-400/50 space-y-8">
        <!-- Pain Point -->
        <div class="relative">
          <div class="absolute -left-[21px] w-3 h-3 rounded-full bg-indigo-500"></div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-3">
            <span class="text-blue-600 dark:text-[#58a6ff]">1.1</span> 痛点：跨境汇款的困境
          </h3>
          <div class="bg-slate-50 dark:bg-[#0d1117] rounded-lg p-5 border border-slate-200 dark:border-[#30363d] transition-colors">
            <p class="text-slate-700 dark:text-[#c9d1d9] mb-4">
              你在非洲有亲人需要钱。你去银行汇款，手续费 <span class="font-bold text-red-500">10%</span>，到账 <span class="font-bold">3-5 天</span>，还要求你有银行账户——但全球有 <span class="font-bold text-indigo-600 dark:text-indigo-400">17 亿成年人</span>没有银行账户。
            </p>
            <div class="p-4 bg-indigo-50 dark:bg-indigo-500/10 border border-indigo-200 dark:border-indigo-500/30 rounded-lg">
              <p class="text-sm text-indigo-700 dark:text-indigo-300">
                <span class="font-bold">没有机构，就没有信任，就没有转账。</span>
              </p>
            </div>
          </div>
        </div>

        <!-- UTXO Model -->
        <div class="relative">
          <div class="absolute -left-[21px] w-3 h-3 rounded-full bg-indigo-500"></div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-3">
            <span class="text-blue-600 dark:text-[#58a6ff]">1.2</span> <GlossaryTerm term="UTXO" /> 模型 vs 账户模型
          </h3>
          <div class="bg-slate-50 dark:bg-[#0d1117] rounded-lg p-5 border border-slate-200 dark:border-[#30363d] transition-colors">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="p-4 bg-white dark:bg-[#161b22] rounded-lg border-l-2 border-amber-500 transition-colors">
                <p class="font-bold text-amber-600 dark:text-amber-400 mb-2">BTC (UTXO)</p>
                <p class="text-sm text-slate-600 dark:text-[#8b949e] mb-2">
                  每笔交易消耗旧输出、产生新输出，类似现金找零。每笔交易都是独立的「硬币」。
                </p>
                <p class="text-xs text-slate-500 dark:text-[#8b949e]">更好的隐私性，类似现金</p>
              </div>
              <div class="p-4 bg-white dark:bg-[#161b22] rounded-lg border-l-2 border-blue-500 transition-colors">
                <p class="font-bold text-blue-600 dark:text-blue-400 mb-2">ETH (账户模型)</p>
                <p class="text-sm text-slate-600 dark:text-[#8b949e] mb-2">
                  类似银行账户，余额是全局状态。直接扣除和增加，更简单直观。
                </p>
                <p class="text-xs text-slate-500 dark:text-[#8b949e]">更好的智能合约支持</p>
              </div>
            </div>
          </div>
        </div>

        <!-- PoW Consensus -->
        <div class="relative">
          <div class="absolute -left-[21px] w-3 h-3 rounded-full bg-indigo-500"></div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-3">
            <span class="text-blue-600 dark:text-[#58a6ff]">1.3</span> <GlossaryTerm term="PoW" /> 共识：不可篡改的数学证明
          </h3>
          <div class="bg-slate-50 dark:bg-[#0d1117] rounded-lg p-5 border border-slate-200 dark:border-[#30363d] transition-colors">
            <p class="text-sm text-slate-600 dark:text-[#8b949e] mb-4">
              <GlossaryTerm term="PoW" /> 工作量证明：靠算力挖矿，能耗高但经过最长时间验证。篡改历史的成本等同于重新消耗全网算力。
            </p>
            <div class="p-4 bg-[#0d1117] dark:bg-[#0d1117] rounded border border-[#30363d]">
              <p class="font-mono text-sm text-emerald-600 dark:text-[#7ee787] mb-2">// 为什么 PoW 安全？</p>
              <p class="font-mono text-xs text-slate-600 dark:text-[#8b949e]">
                攻击成本 &gt; 攻击收益<br>
                1 小时攻击成本：电力 + 算力以百万美元量级计（不含矿机投入）<br>
                物理成本：需要 51% 算力，矿机设备投入以十亿美元计
              </p>
            </div>
          </div>
        </div>

        <!-- Layer1 Comparison -->
        <div class="relative">
          <div class="absolute -left-[21px] w-3 h-3 rounded-full bg-indigo-500"></div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-3">
            <span class="text-blue-600 dark:text-[#58a6ff]">1.4</span> 主要 Layer1 格局
          </h3>
          <div class="bg-slate-50 dark:bg-[#0d1117] rounded-lg p-5 border border-slate-200 dark:border-[#30363d] transition-colors">
            <div class="overflow-x-auto">
              <table class="w-full text-sm font-mono">
                <thead class="bg-slate-100 dark:bg-[#161b22] transition-colors">
                  <tr class="text-left text-slate-500 dark:text-[#8b949e]">
                    <th class="py-2 px-3">Chain</th>
                    <th class="py-2 px-3">共识</th>
                    <th class="py-2 px-3">TPS</th>
                    <th class="py-2 px-3">平均费用</th>
                    <th class="py-2 px-3">定位</th>
                  </tr>
                </thead>
                <tbody class="text-slate-700 dark:text-[#c9d1d9]">
                  <tr class="border-t border-slate-200 dark:border-[#21262d]">
                    <td class="py-2 px-3 text-amber-600 dark:text-amber-400">Bitcoin</td>
                    <td class="py-2 px-3">PoW</td>
                    <td class="py-2 px-3">~7</td>
                    <td class="py-2 px-3 text-emerald-600 dark:text-emerald-400">≈$0.5-5</td>
                    <td class="py-2 px-3">数字黄金</td>
                  </tr>
                  <tr class="border-t border-slate-200 dark:border-[#21262d]">
                    <td class="py-2 px-3 text-indigo-600 dark:text-indigo-400">Ethereum</td>
                    <td class="py-2 px-3">PoS</td>
                    <td class="py-2 px-3">~15-30</td>
                    <td class="py-2 px-3 text-amber-600 dark:text-amber-400">≈$0.5-5</td>
                    <td class="py-2 px-3">世界计算机</td>
                  </tr>
                  <tr class="border-t border-slate-200 dark:border-[#21262d]">
                    <td class="py-2 px-3 text-purple-600 dark:text-purple-400">Solana</td>
                    <td class="py-2 px-3">PoH + PoS</td>
                    <td class="py-2 px-3 text-emerald-600 dark:text-emerald-400">实际 1,000-4,000</td>
                    <td class="py-2 px-3 text-emerald-600 dark:text-emerald-400">&lt;$0.001</td>
                    <td class="py-2 px-3">高性能应用链</td>
                  </tr>
                  <tr class="border-t border-slate-200 dark:border-[#21262d]">
                    <td class="py-2 px-3 text-emerald-600 dark:text-emerald-400">Cosmos</td>
                    <td class="py-2 px-3">Tendermint</td>
                    <td class="py-2 px-3">数百至数千（依链而定）</td>
                    <td class="py-2 px-3 text-emerald-600 dark:text-emerald-400">&lt;$0.01</td>
                    <td class="py-2 px-3">跨链 Hub</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 02: 去中心化计算 (Ethereum) -->
    <section id="phase2" class="mb-16 scroll-mt-8">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-purple-500 to-pink-600 text-white font-bold flex items-center justify-center">2</div>
        <div>
          <h2 class="text-2xl font-bold text-slate-900 dark:text-white">去中心化计算</h2>
          <p class="text-slate-500 dark:text-[#8b949e] text-sm font-mono">Ethereum · 核心问题：能不能让规则自动执行？</p>
        </div>
      </div>

      <div class="pl-4 border-l-2 border-purple-500 dark:border-purple-400/50 space-y-8">
        <!-- Pain Point -->
        <div class="relative">
          <div class="absolute -left-[21px] w-3 h-3 rounded-full bg-purple-500"></div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-3">
            <span class="text-blue-600 dark:text-[#58a6ff]">2.1</span> 痛点：规则执行依赖人
          </h3>
          <div class="bg-slate-50 dark:bg-[#0d1117] rounded-lg p-5 border border-slate-200 dark:border-[#30363d] transition-colors">
            <p class="text-slate-700 dark:text-[#c9d1d9] mb-4">
              你和陌生人签了一份合同，约定「如果我按时交货，你就付款」。但付款这件事，还是靠对方自觉——或者打官司。
            </p>
            <div class="p-4 bg-purple-50 dark:bg-purple-500/10 border border-purple-200 dark:border-purple-500/30 rounded-lg">
              <p class="text-sm text-purple-700 dark:text-purple-300">
                <span class="font-bold">「规则执行」这件事，一直需要人来中间撮合。有人就有腐败、有延迟、有成本。</span>
              </p>
            </div>
          </div>
        </div>

        <!-- EVM -->
        <div class="relative">
          <div class="absolute -left-[21px] w-3 h-3 rounded-full bg-purple-500"></div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-3">
            <span class="text-blue-600 dark:text-[#58a6ff]">2.2</span> <GlossaryTerm term="EVM" />：世界计算机的心脏
          </h3>
          <div class="bg-slate-50 dark:bg-[#0d1117] rounded-lg p-5 border border-slate-200 dark:border-[#30363d] transition-colors">
            <p class="text-sm text-slate-600 dark:text-[#8b949e] mb-4">
              EVM (Ethereum Virtual Machine) 是图灵完备的虚拟机，运行所有以太坊智能合约。
            </p>
            <div class="p-4 bg-[#0d1117] dark:bg-[#0d1117] rounded border border-[#30363d] mb-4">
              <p class="font-mono text-xs text-emerald-600 dark:text-[#7ee787] mb-2">// 编译流程</p>
              <p class="font-mono text-xs text-slate-600 dark:text-[#8b949e]">
                任何语言 → Solidity → EVM bytecode → 执行
              </p>
            </div>
            <p class="text-sm text-slate-600 dark:text-[#8b949e]">
              <span class="font-bold text-purple-600 dark:text-purple-400">EVM 兼容链：</span>Arbitrum、Base、Optimism、zkSync — 一次编写，多链部署
            </p>
          </div>
        </div>

        <!-- Gas Economics -->
        <div class="relative">
          <div class="absolute -left-[21px] w-3 h-3 rounded-full bg-purple-500"></div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-3">
            <span class="text-blue-600 dark:text-[#58a6ff]">2.3</span> Gas 经济学
          </h3>
          <div class="bg-slate-50 dark:bg-[#0d1117] rounded-lg p-5 border border-slate-200 dark:border-[#30363d] transition-colors">
            <p class="font-mono text-sm text-emerald-600 dark:text-[#7ee787] mb-4">// Gas = 计算工作量 × Gas 价格</p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="p-4 bg-white dark:bg-[#161b22] rounded-lg transition-colors">
                <p class="font-bold text-slate-900 dark:text-white mb-2">Base Fee (基础费)</p>
                <p class="text-sm text-slate-600 dark:text-[#8b949e]">由协议根据网络拥堵自动调节，目标区块利用率50%。燃烧机制 (EIP-1559)。</p>
              </div>
              <div class="p-4 bg-white dark:bg-[#161b22] rounded-lg transition-colors">
                <p class="font-bold text-slate-900 dark:text-white mb-2">Priority Fee (优先费)</p>
                <p class="text-sm text-slate-600 dark:text-[#8b949e]">给验证者的小费，用于优先打包交易。MEV 的一部分。</p>
              </div>
            </div>
            <div class="mt-4 p-4 bg-amber-50 dark:bg-[#f0883e]/10 border border-amber-200 dark:border-[#f0883e]/30 rounded-lg">
              <p class="text-sm text-amber-700 dark:text-[#f0883e]">
                <span class="font-bold">关键数据：</span>以太坊主网 Gas 通常在个位数到几十 gwei 波动（Dencun 升级后长期低于 10 gwei），L2 (Arbitrum/Base) Gas 不足 0.01 gwei，费用差距可达 <span class="font-mono">1000倍</span>
              </p>
            </div>
          </div>
        </div>

        <!-- Layer2 -->
        <div class="relative">
          <div class="absolute -left-[21px] w-3 h-3 rounded-full bg-purple-500"></div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-3">
            <span class="text-blue-600 dark:text-[#58a6ff]">2.4</span> <GlossaryTerm term="Layer2" /> 扩容方案
          </h3>
          <div class="bg-slate-50 dark:bg-[#0d1117] rounded-lg p-5 border border-slate-200 dark:border-[#30363d] transition-colors">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="p-4 bg-white dark:bg-[#161b22] rounded-lg border border-indigo-200 dark:border-[#58a6ff]/30 transition-colors">
                <p class="font-bold text-indigo-600 dark:text-indigo-400 mb-2"><GlossaryTerm term="Optimistic Rollups" /></p>
                <p class="text-xs text-slate-500 dark:text-[#8b949e] mb-2">乐观假设交易有效，7天挑战期</p>
                <div class="space-y-1 text-xs text-slate-600 dark:text-[#8b949e]">
                  <p><span class="font-mono text-amber-600 dark:text-amber-400">Arbitrum</span> — TVL $7.8B</p>
                  <p><span class="font-mono text-blue-600 dark:text-blue-400">Base</span> — Coinbase 背书</p>
                  <p><span class="font-mono text-red-600 dark:text-red-400">Optimism</span> — OP Stack</p>
                </div>
              </div>
              <div class="p-4 bg-white dark:bg-[#161b22] rounded-lg border border-purple-200 dark:border-purple-500/30 transition-colors">
                <p class="font-bold text-purple-600 dark:text-purple-400 mb-2"><GlossaryTerm term="ZK Rollups" /></p>
                <p class="text-xs text-slate-500 dark:text-[#8b949e] mb-2">零知识证明，无需信任假设</p>
                <div class="space-y-1 text-xs text-slate-600 dark:text-[#8b949e]">
